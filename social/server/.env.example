# Copy this to '.env' and fill in real values for local development
# MongoDB connection string (local example)
dbUrl=mongodb://127.0.0.1:27017/socialdb

# JWT secret used for token generation
JWT_SECRET=replace_with_a_secure_string

# Cloudinary credentials (optional - required if uploading media)
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloud_api_key
CLOUD_API_SECRET=your_cloud_api_secret
